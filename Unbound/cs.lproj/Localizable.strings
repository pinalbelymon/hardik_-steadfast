"challenge.deep_breaths" = "Udělej 10 hlubokých nádechů";
"challenge.deep_breaths.desc" = "Pomalu se nadechni nosem, krátce zadrž a vydechni ústy. Opakuj, dokud se neuklidníš.";
"challenge.drink_water" = "Vypij sklenici vody";
"challenge.drink_water.desc" = "Naplň sklenici a pomalu ji vypij. Hydratace pomáhá resetovat tělo i mysl.";
"challenge.jumping_jacks" = "Udělej 20 výskoků s rozpažením";
"challenge.jumping_jacks.desc" = "Postav se rovně, vyskoč s rozpažením a rozkročením a vrať se. Pohybuj se tempem, které ti vyhovuje.";
"challenge.phone_away_5min" = "Odlož telefon na 5 minut";
"challenge.phone_away_5min.desc" = "Polož telefon obrazovkou dolů nebo na jiné místo. Využij pauzu k dýchání nebo rozhlédnutí.";
"challenge.grateful" = "Napiš 3 věci, za které jsi vděčný";
"challenge.grateful.desc" = "Vezmi papír nebo poznámky a napiš tři malé věci, které se dnes povedly.";
"challenge.walk_2min" = "Projdě se 2 minuty";
"challenge.walk_2min.desc" = "Odejdi od obrazovky a projdi se kdekoli – chodbou, pokojem nebo venku.";
"challenge.name_5_things" = "Pojmenuj 5 věcí, které vidíš";
"challenge.name_5_things.desc" = "Rozhlédni se a potichu pojmenuj pět předmětů, které vidíš. To tě uzemní v přítomnosti.";
"challenge.mindfulness_2min" = "2minutová všímavost";
"challenge.mindfulness_2min.desc" = "Sedni si v klidu a vnímej dech, zvuky a tělo. Když se mysl zatoulá, jemně se vrať.";
"challenge.social_media_5min" = "5minutová pauza od sociálních sítí";
"challenge.social_media_5min.desc" = "Zavři sociální aplikace a udělej něco offline – protažení, doušek vody nebo jen dýchej.";
"challenge.stretch_2min" = "Protáhni se 2 minuty";
"challenge.stretch_2min.desc" = "Zvedni ruce nad hlavu, zakruť rameny a jemně protáhni krk a záda.";
"challenge.walk_5min" = "Projdě se 5 minut";
"challenge.walk_5min.desc" = "Udělej si krátkou procházku bez telefonu. Vnímej kroky a okolí.";
"challenge.listen_song" = "Poslechni si jednu píseň";
"challenge.listen_song.desc" = "Pusť si jednu písničku, kterou máš rád, a poslouchej ji naplno – bez scrollování.";
"challenge.sit_outside" = "Sedni si venku na 2 minuty";
"challenge.sit_outside.desc" = "Vyjdi ven nebo otevři okno a sedni si v klidu na pár minut.";
"challenge.wash_face" = "Umyj si obličej";
"challenge.wash_face.desc" = "Postříkej si obličej studenou vodou. Fyzický reset může rychle přerušit chuť.";
"challenge.open_window" = "Otevři okno pro čerstvý vzduch";
"challenge.open_window.desc" = "Pusť dovnitř čerstvý vzduch a párkrát se zhluboka nadechni u okna.";
"challenge.tidy_desk" = "Uklid si stůl na 3 minuty";
"challenge.tidy_desk.desc" = "Odstraň nepořádek, srovnej papíry a dej jedno místo do pořádku.";
"challenge.read_2_pages" = "Přečti dvě stránky";
"challenge.read_2_pages.desc" = "Otevři knihu nebo článek a přečti jen dvě stránky – bez telefonu v dosahu.";
"challenge.message_friend" = "Napiš kamarádovi";
