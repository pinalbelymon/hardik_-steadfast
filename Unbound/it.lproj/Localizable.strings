/* Challenges & Rescue */
"challenge.deep_breaths" = "Fai 10 respiri profondi";
"challenge.deep_breaths.desc" = "Inspira lentamente dal naso, trattieni un attimo, poi espira dalla bocca. Ripeti finché non ti senti più calmo.";
"challenge.drink_water" = "Bevi un bicchiere d'acqua";
"challenge.drink_water.desc" = "Riempi un bicchiere e bevilo lentamente. L'idratazione aiuta a resettare corpo e mente.";
"challenge.jumping_jacks" = "Fai 20 jumping jack";
"challenge.jumping_jacks.desc" = "Stai in piedi, salta aprendo braccia e gambe, poi torna. Muoviti a un ritmo confortevole.";
"challenge.phone_away_5min" = "Metti via il telefono per 5 minuti";
"challenge.phone_away_5min.desc" = "Metti il telefono a faccia in giù o in un altro posto. Usa la pausa per respirare o guardarti intorno.";
"challenge.grateful" = "Scrivi 3 cose per cui sei grato";
"challenge.grateful.desc" = "Prendi carta o note e scrivi tre piccole cose andate bene oggi.";
"challenge.walk_2min" = "Cammina per 2 minuti";
"challenge.walk_2min.desc" = "Allontanati dallo schermo e cammina ovunque — corridoio, stanza o fuori.";
"challenge.name_5_things" = "Nomina 5 cose che vedi";
"challenge.name_5_things.desc" = "Guardati intorno e nomina silenziosamente cinque oggetti che puoi vedere. Questo ti ancora al presente.";
"challenge.mindfulness_2min" = "2 minuti di consapevolezza";
"challenge.mindfulness_2min.desc" = "Siediti fermo e nota il respiro, i suoni e il corpo. Quando la mente vaga, torna delicatamente.";
"challenge.social_media_5min" = "Pausa di 5 minuti dai social";
"challenge.social_media_5min.desc" = "Chiudi le app social e fai qualcosa offline — stirati, bevi un sorso d'acqua o semplicemente respira.";
"challenge.stretch_2min" = "Stirati per 2 minuti";
"challenge.stretch_2min.desc" = "Allunga le braccia verso l'alto, ruota le spalle e stira delicatamente collo e schiena.";
"challenge.walk_5min" = "Cammina per 5 minuti";
"challenge.walk_5min.desc" = "Fai una breve passeggiata senza telefono. Nota i tuoi passi e l'ambiente.";
"challenge.listen_song" = "Ascolta una canzone";
"challenge.listen_song.desc" = "Metti una canzone che ti piace e ascoltala per intero — senza scorrere.";
"challenge.sit_outside" = "Siediti fuori per 2 minuti";
"challenge.sit_outside.desc" = "Esci o apri una finestra e siediti in silenzio per un paio di minuti.";
"challenge.wash_face" = "Lavati il viso";
"challenge.wash_face.desc" = "Spruzza acqua fresca sul viso. Il reset fisico può interrompere rapidamente un impulso.";
"challenge.open_window" = "Apri una finestra per aria fresca";
"challenge.open_window.desc" = "Fai entrare aria fresca e fai qualche respiro profondo vicino alla finestra.";
"challenge.tidy_desk" = "Riordina la scrivania per 3 minuti";
"challenge.tidy_desk.desc" = "Togli il disordine, impila i fogli e metti a posto un'area.";
"challenge.read_2_pages" = "Leggi due pagine";
"challenge.read_2_pages.desc" = "Apri un libro o un articolo e leggi solo due pagine — senza telefono vicino.";
"challenge.message_friend" = "Manda un messaggio a un amico";
"challenge.message_friend.desc" = "Invia un saluto genuino a qualcuno a cui tieni. La connessione batte lo scorrere infinito.";
"challenge.squats_10" = "Fai 10 squat";
"challenge.squats_10.desc" = "Piedi alla larghezza delle spalle, abbassa i fianchi e rialzati. Vai piano e in modo controllato.";
"challenge.journal_line" = "Scrivi una riga di diario";
"challenge.journal_line.desc" = "Scrivi una frase onesta su come ti senti in questo momento.";
"challenge.box_breathing" = "Respirazione a scatola per 1 minuto";
"challenge.box_breathing.desc" = "Inspira 4 tempi, trattieni 4, espira 4, trattieni 4. Ripeti per un minuto.";
"challenge.sunlight_2min" = "Espòniti alla luce del sole per 2 minuti";
"challenge.sunlight_2min.desc" = "Stai vicino a una finestra o esci e senti la luce sul viso.";
"challenge.make_bed" = "Fai il letto";
"challenge.make_bed.desc" = "Stendi le lenzuola e resetta il tuo spazio. Le piccole vittorie costruiscono slancio.";
"challenge.calm_audio" = "Ascolta audio rilassante";
"challenge.calm_audio.desc" = "Metti qualcosa di calmante — suoni della natura, musica soft o una breve meditazione.";
"challenge.phone_other_room" = "Metti il telefono in un'altra stanza";
"challenge.phone_other_room.desc" = "Lascia il telefono in un'altra stanza per qualche minuto mentre ti resetti.";
"challenge.plan_tomorrow" = "Pianifica un obiettivo per domani";
"challenge.plan_tomorrow.desc" = "Scrivi un piccolo obiettivo chiaro che vuoi raggiungere domani.";
"challenge.kind_self" = "Dì qualcosa di gentile a te stesso";
"challenge.kind_self.desc" = "Parla a te stesso come farebbe un buon amico — una frase di incoraggiamento ad alta voce.";
"challenge.digital_break_10" = "Pausa dallo schermo di 10 minuti";
"challenge.digital_break_10.desc" = "Allontanati da tutti gli schermi per dieci minuti. Muoviti, respira o riposa gli occhi.";
"challenge.stand_stretch" = "Alzati e stirati per 1 minuto";
"challenge.stand_stretch.desc" = "Alzati, allungati verso l'alto e allenta spalle e schiena.";
"challenge.draw_something" = "Disegna qualcosa per 5 minuti";
"challenge.draw_something.desc" = "Scarabbocchia, schizza o colora per cinque minuti — non serve la perfezione.";
"challenge.clean_one_area" = "Pulisci una piccola area";
"challenge.clean_one_area.desc" = "Scegli un punto — uno scaffale, un piano o un cassetto — e riordinalo per cinque minuti.";
"challenge.no_phone_meal" = "Mangia senza telefono";
"challenge.no_phone_meal.desc" = "Fai uno spuntino o un pasto senza schermi. Concentrati sul sapore e su come ti senti.";
"challenge.pushups_5" = "Fai 5 flessioni";
"challenge.pushups_5.desc" = "Fai cinque flessioni a terra o contro il muro. La forma conta più della velocità.";
"challenge.focus_5min" = "Blocco di concentrazione di 5 minuti";
"challenge.focus_5min.desc" = "Scegli un'attività e lavoci sopra senza distrazioni per cinque minuti.";
"challenge.gratitude_text" = "Invia un messaggio di ringraziamento";
"challenge.gratitude_text.desc" = "Manda a qualcuno un breve ringraziamento o un messaggio gentile. La gratitudine rafforza il recupero.";
"challenge.walk_outside" = "Cammina fuori per 5 minuti";
"challenge.walk_outside.desc" = "Esci di casa o dall'ufficio e cammina a ritmo comodo per cinque minuti.";
"challenge.tea_break" = "Fai una pausa tè consapevole";
