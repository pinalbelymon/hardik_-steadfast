/* Challenges & Rescue */
"challenge.deep_breaths" = "深呼吸を10回する";
"challenge.deep_breaths.desc" = "鼻からゆっくり息を吸い、少し止めてから口から吐き出します。落ち着くまで繰り返しましょう。";
"challenge.drink_water" = "水を1杯飲む";
"challenge.drink_water.desc" = "コップに水を入れてゆっくり飲みましょう。水分補給は心と体をリセットするのに役立ちます。";
"challenge.jumping_jacks" = "ジャンピングジャックを20回する";
"challenge.jumping_jacks.desc" = "まっすぐ立ち、腕と脚を広げながらジャンプし、元に戻します。心地よいペースで行いましょう。";
"challenge.phone_away_5min" = "5分間スマホを手放す";
"challenge.phone_away_5min.desc" = "スマホを裏返すか別の場所に置きましょう。その時間で呼吸をしたり周りを見渡したりしてみましょう。";
"challenge.grateful" = "感謝していることを3つ書く";
"challenge.grateful.desc" = "紙やメモを用意して、今日うまくいった小さなことを3つ書き出しましょう。";
"challenge.walk_2min" = "2分間歩く";
"challenge.walk_2min.desc" = "画面から離れて、廊下や部屋、外などどこでも歩いてみましょう。";
"challenge.name_5_things" = "見えるものを5つ挙げる";
"challenge.name_5_things.desc" = "周りを見渡して、見えるものを5つ静かに挙げましょう。今この瞬間に意識を戻せます。";
"challenge.mindfulness_2min" = "2分間のマインドフルネス";
"challenge.mindfulness_2min.desc" = "静かに座り、呼吸、音、体の感覚に意識を向けましょう。気が散ったら、やさしく意識を戻します。";
"challenge.social_media_5min" = "SNSから5分間離れる";
"challenge.social_media_5min.desc" = "SNSアプリを閉じて、オフラインで何かをしましょう。ストレッチをしたり、水を飲んだり、ただ呼吸したり。";
"challenge.stretch_2min" = "2分間ストレッチする";
"challenge.stretch_2min.desc" = "腕を上に伸ばし、肩を回し、首と背中をやさしく伸ばしましょう。";
"challenge.walk_5min" = "5分間歩く";
"challenge.walk_5min.desc" = "スマホを持たずに少し歩きましょう。自分の足取りと周りの景色に意識を向けて。";
"challenge.listen_song" = "曲を1曲聴く";
"challenge.listen_song.desc" = "好きな曲を1曲かけて、じっくり聴きましょう。再生中はスクロールしないで。";
"challenge.sit_outside" = "外で2分間座る";
"challenge.sit_outside.desc" = "外に出るか窓を開けて、数分間静かに座りましょう。";
"challenge.wash_face" = "顔を洗う";
"challenge.wash_face.desc" = "顔に冷たい水をかけましょう。物理的なリセットは衝動をすばやく断ち切るのに役立ちます。";
"challenge.open_window" = "窓を開けて外気を入れる";
"challenge.open_window.desc" = "新鮮な空気を取り込み、窓のそばで深呼吸を数回しましょう。";
"challenge.tidy_desk" = "3分間デスクを片付ける";
"challenge.tidy_desk.desc" = "散らかったものを整理し、書類を重ね、一角を元通りにしましょう。";
"challenge.read_2_pages" = "2ページ読む";
"challenge.read_2_pages.desc" = "本や記事を開いて、スマホを手放して2ページだけ読みましょう。";
"challenge.message_friend" = "友人にメッセージを送る";
"challenge.message_friend.desc" = "大切な人に心のこもった一言を送りましょう。つながりはスクロールに勝ります。";
"challenge.squats_10" = "スクワットを10回する";
"challenge.squats_10.desc" = "足を肩幅に開き、腰を下げてから立ち上がります。ゆっくり丁寧に行いましょう。";
"challenge.journal_line" = "日記を一行書く";
"challenge.journal_line.desc" = "今の気持ちについて、正直な一文を書いてみましょう。";
"challenge.box_breathing" = "ボックス呼吸を1分間行う";
"challenge.box_breathing.desc" = "4カウントで吸い、4カウント止め、4カウントで吐き、4カウント止めます。これを1分間繰り返します。";
"challenge.sunlight_2min" = "2分間日光を浴びる";
"challenge.sunlight_2min.desc" = "窓のそばに立つか外に出て、顔に光を感じましょう。";
