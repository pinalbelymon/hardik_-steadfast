/* Challenges & Rescue */
"challenge.deep_breaths" = "Fă 10 respirații adânci";
"challenge.deep_breaths.desc" = "Inspiră încet pe nas, ține puțin, apoi expiră pe gură. Repetă până te simți mai calm.";
"challenge.drink_water" = "Bea un pahar cu apă";
"challenge.drink_water.desc" = "Umple un pahar și bea-l încet. Hidratarea ajută la resetarea corpului și minții.";
"challenge.jumping_jacks" = "Fă 20 de sărituri stea";
"challenge.jumping_jacks.desc" = "Stai drept, sari deschizând brațele și picioarele, apoi revino. Mișcă-te într-un ritm confortabil.";
"challenge.phone_away_5min" = "Pune telefonul deoparte 5 minute";
"challenge.phone_away_5min.desc" = "Pune telefonul cu ecranul în jos sau în alt loc. Folosește pauza pentru a respira sau a privi în jur.";
"challenge.grateful" = "Scrie 3 lucruri pentru care ești recunoscător";
"challenge.grateful.desc" = "Ia hârtie sau notițe și scrie trei lucruri mici care au mers bine azi.";
"challenge.walk_2min" = "Mergi 2 minute";
"challenge.walk_2min.desc" = "Îndepărtează-te de ecran și mergi oriunde — pe hol, în cameră sau afară.";
"challenge.name_5_things" = "Numără 5 lucruri pe care le vezi";
"challenge.name_5_things.desc" = "Privește în jur și numește în liniște cinci obiecte pe care le poți vedea. Te ancorează în prezent.";
"challenge.mindfulness_2min" = "2 minute de mindfulness";
"challenge.mindfulness_2min.desc" = "Stai nemișcat și observă respirația, sunetele și corpul. Când mintea rătăcește, revino blând.";
"challenge.social_media_5min" = "Pauză de 5 minute de pe rețelele sociale";
"challenge.social_media_5min.desc" = "Închide aplicațiile de social media și fă ceva offline — întinde-te, bea apă sau pur și simplu respiră.";
"challenge.stretch_2min" = "Întinde-te 2 minute";
"challenge.stretch_2min.desc" = "Întinde brațele în sus, rotește umerii și întinde blând gâtul și spatele.";
"challenge.walk_5min" = "Mergi 5 minute";
"challenge.walk_5min.desc" = "Fă o scurtă plimbare fără telefon. Observă pașii și împrejurimile.";
"challenge.listen_song" = "Ascultă o melodie";
"challenge.listen_song.desc" = "Pune o melodie care îți place și ascult-o complet — fără să derulezi.";
"challenge.sit_outside" = "Stai afară 2 minute";
"challenge.sit_outside.desc" = "Ieși sau deschide o fereastră și stai liniștit câteva minute.";
"challenge.wash_face" = "Spală-te pe față";
"challenge.wash_face.desc" = "Stropeste-ți fața cu apă rece. Resetarea fizică poate întrerupe rapid un impuls.";
"challenge.open_window" = "Deschide o fereastră pentru aer proaspăt";
"challenge.open_window.desc" = "Lasă să intre aer proaspăt și fă câteva respirații adânci lângă fereastră.";
"challenge.tidy_desk" = "Ordona biroul 3 minute";
"challenge.tidy_desk.desc" = "Curăță dezordinea, stivuiește hârtiile și pune o zonă în ordine.";
"challenge.read_2_pages" = "Citește două pagini";
"challenge.read_2_pages.desc" = "Deschide o carte sau un articol și citește doar două pagini — fără telefon aproape.";
"challenge.message_friend" = "Trimite un mesaj unui prieten";
"challenge.message_friend.desc" = "Trimite un salut sincer cuiva la care ții. Conexiunea bate derularea interminabilă.";
"challenge.squats_10" = "Fă 10 genuflexiuni";
"challenge.squats_10.desc" = "Picioarele la lățimea umerilor, coboară șoldurile și ridică-te. Mergi încet și controlat.";
"challenge.journal_line" = "Scrie un rând de jurnal";
"challenge.journal_line.desc" = "Scrie o propoziție sinceră despre cum te simți acum.";
"challenge.box_breathing" = "Respirație în cutie 1 minut";
"challenge.box_breathing.desc" = "Inspiră 4, ține 4, expiră 4, ține 4. Repetă un minut.";
"challenge.sunlight_2min" = "Stai la soare 2 minute";
"challenge.sunlight_2min.desc" = "Stai lângă o fereastră sau ieși și simte lumina pe față.";
"challenge.make_bed" = "Fă patul";
"challenge.make_bed.desc" = "Întinde cearșafurile și resetează spațiul. Micile victorii construiesc impuls.";
"challenge.calm_audio" = "Ascultă audio calm";
"challenge.calm_audio.desc" = "Pune ceva liniștitor — sunete din natură, muzică blândă sau o meditație scurtă.";
"challenge.phone_other_room" = "Pune telefonul în altă cameră";
"challenge.phone_other_room.desc" = "Lasă telefonul în altă cameră câteva minute în timp ce te resetezi.";
"challenge.plan_tomorrow" = "Planifică un obiectiv pentru mâine";
"challenge.plan_tomorrow.desc" = "Scrie un obiectiv mic și clar pe care vrei să-l atingi mâine.";
"challenge.kind_self" = "Spune-ți ceva bun";
"challenge.kind_self.desc" = "Vorbește-ți ca unui bun prieten — o propoziție încurajatoare cu voce tare.";
"challenge.digital_break_10" = "Pauză de ecran de 10 minute";
"challenge.digital_break_10.desc" = "Îndepărtează-te de toate ecranele zece minute. Mișcă-te, respiră sau odihnește ochii.";
"challenge.stand_stretch" = "Ridică-te și întinde-te 1 minut";
"challenge.stand_stretch.desc" = "Ridică-te, întinde-te în sus și relaxează umerii și spatele.";
"challenge.draw_something" = "Desenează ceva 5 minute";
"challenge.draw_something.desc" = "Mâzgălește, schițează sau colorează cinci minute — nu e nevoie de perfecțiune.";
"challenge.clean_one_area" = "Curăță o zonă mică";
"challenge.clean_one_area.desc" = "Alege un loc — un raft, o blat sau un sertar — și ordonează-l cinci minute.";
"challenge.no_phone_meal" = "Mănâncă fără telefon";
