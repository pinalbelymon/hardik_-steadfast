/* Challenges & Rescue */
"challenge.deep_breaths" = "Haz 10 respiraciones profundas";
"challenge.deep_breaths.desc" = "Inhala lentamente por la nariz, mantén un momento y exhala por la boca. Repite hasta sentirte más calmado.";
"challenge.drink_water" = "Bebe un vaso de agua";
"challenge.drink_water.desc" = "Llena un vaso y bébelo despacio. La hidratación ayuda a reiniciar cuerpo y mente.";
"challenge.jumping_jacks" = "Haz 20 saltos de tijera";
"challenge.jumping_jacks.desc" = "Ponte de pie, salta abriendo brazos y piernas y vuelve. Muévete a un ritmo cómodo.";
"challenge.phone_away_5min" = "Deja el móvil a un lado durante 5 minutos";
"challenge.phone_away_5min.desc" = "Pon el móvil boca abajo o en otro sitio. Usa el descanso para respirar o mirar a tu alrededor.";
"challenge.grateful" = "Escribe 3 cosas por las que estés agradecido";
"challenge.grateful.desc" = "Coge papel o notas y escribe tres cosas pequeñas que hayan salido bien hoy.";
"challenge.walk_2min" = "Camina durante 2 minutos";
"challenge.walk_2min.desc" = "Aléjate de la pantalla y camina por el pasillo, la habitación o fuera.";
"challenge.name_5_things" = "Nombra 5 cosas que veas";
"challenge.name_5_things.desc" = "Mira a tu alrededor y nombra en voz baja cinco objetos que puedas ver. Esto te ancla en el presente.";
"challenge.mindfulness_2min" = "2 minutos de atención plena";
"challenge.mindfulness_2min.desc" = "Siéntate quieto y observa tu respiración, los sonidos y el cuerpo. Cuando la mente divague, vuelve con suavidad.";
"challenge.social_media_5min" = "Descanso de 5 minutos de redes sociales";
"challenge.social_media_5min.desc" = "Cierra las apps de redes y haz algo offline: estírate, bebe agua o simplemente respira.";
"challenge.stretch_2min" = "Estírate durante 2 minutos";
"challenge.stretch_2min.desc" = "Estira los brazos hacia arriba, rota los hombros y estira cuello y espalda con suavidad.";
"challenge.walk_5min" = "Camina durante 5 minutos";
"challenge.walk_5min.desc" = "Da un paseo corto sin el móvil. Observa tus pasos y el entorno.";
"challenge.listen_song" = "Escucha una canción";
"challenge.listen_song.desc" = "Pon una canción que te guste y escúchala completa, sin deslizar la pantalla.";
"challenge.sit_outside" = "Siéntate fuera durante 2 minutos";
"challenge.sit_outside.desc" = "Sal o abre una ventana y siéntate en silencio un par de minutos.";
"challenge.wash_face" = "Lávate la cara";
"challenge.wash_face.desc" = "Salpícalo con agua fresca. El reinicio físico puede cortar el impulso rápidamente.";
"challenge.open_window" = "Abre una ventana para coger aire fresco";
"challenge.open_window.desc" = "Deja entrar aire fresco y respira hondo varias veces junto a la ventana.";
"challenge.tidy_desk" = "Ordena tu escritorio durante 3 minutos";
"challenge.tidy_desk.desc" = "Quita el desorden, apila papeles y deja una zona en orden.";
"challenge.read_2_pages" = "Lee dos páginas";
"challenge.read_2_pages.desc" = "Abre un libro o artículo y lee solo dos páginas, sin el móvil cerca.";
"challenge.message_friend" = "Envía un mensaje a un amigo";
"challenge.message_friend.desc" = "Manda un saludo genuino a alguien que te importe. La conexión vence al desplazamiento infinito.";
"challenge.squats_10" = "Haz 10 sentadillas";
"challenge.squats_10.desc" = "Pies a la anchura de los hombros, baja las caderas y levántate. Ve despacio y con control.";
"challenge.journal_line" = "Escribe una línea de diario";
"challenge.journal_line.desc" = "Escribe una frase sincera sobre cómo te sientes ahora mismo.";
"challenge.box_breathing" = "Respiración en caja durante 1 minuto";
"challenge.box_breathing.desc" = "Inhala 4 tiempos, mantén 4, exhala 4, mantén 4. Repite durante un minuto.";
"challenge.sunlight_2min" = "Ponte al sol durante 2 minutos";
"challenge.sunlight_2min.desc" = "Párate cerca de una ventana o sal fuera y siente la luz en la cara.";
"challenge.make_bed" = "Haz la cama";
"challenge.make_bed.desc" = "Alisa las sábanas y reinicia tu espacio. Las pequeñas victorias generan impulso.";
"challenge.calm_audio" = "Escucha audio relajante";
"challenge.calm_audio.desc" = "Pon algo relajante: sonidos de la naturaleza, música suave o una meditación corta.";
"challenge.phone_other_room" = "Pon el móvil en otra habitación";
"challenge.phone_other_room.desc" = "Deja el móvil en otra habitación unos minutos mientras te reinicias.";
"challenge.plan_tomorrow" = "Planifica un objetivo para mañana";
"challenge.plan_tomorrow.desc" = "Escribe un objetivo pequeño y claro que quieras cumplir mañana.";
"challenge.kind_self" = "Dite algo amable a ti mismo";
"challenge.kind_self.desc" = "Háblate como lo haría un buen amigo: una frase de ánimo en voz alta.";
"challenge.digital_break_10" = "Descanso de pantalla de 10 minutos";
"challenge.digital_break_10.desc" = "Aléjate de todas las pantallas durante diez minutos. Muévete, respira o descansa los ojos.";
"challenge.stand_stretch" = "Párate y estírate durante 1 minuto";
"challenge.stand_stretch.desc" = "Levántate, estira hacia arriba y afloja hombros y espalda.";
"challenge.draw_something" = "Dibuja algo durante 5 minutos";
"challenge.draw_something.desc" = "Garabatea, esboza o colorea durante cinco minutos, sin buscar la perfección.";
"challenge.clean_one_area" = "Limpia una zona pequeña";
"challenge.clean_one_area.desc" = "Elige un sitio (estantería, encimera o cajón) y ordénalo durante cinco minutos.";
"challenge.no_phone_meal" = "Come sin el móvil";
"challenge.no_phone_meal.desc" = "Toma un tentempié o una comida sin pantallas. Concéntrate en el sabor y en cómo te sientes.";
"challenge.pushups_5" = "Haz 5 flexiones";
"challenge.pushups_5.desc" = "Haz cinco flexiones en el suelo o contra la pared. La forma importa más que la velocidad.";
"challenge.focus_5min" = "Bloque de concentración de 5 minutos";
"challenge.focus_5min.desc" = "Elige una tarea y trabaja en ella sin distracciones durante cinco minutos.";
"challenge.gratitude_text" = "Envía un mensaje de agradecimiento";
"challenge.gratitude_text.desc" = "Envía un mensaje corto de agradecimiento o una nota amable. La gratitud refuerza la recuperación.";
"challenge.walk_outside" = "Camina fuera durante 5 minutos";
"challenge.walk_outside.desc" = "Sal de casa o de la oficina y camina a un ritmo fácil durante cinco minutos.";
"challenge.tea_break" = "Toma un descanso consciente con té";
"challenge.tea_break.desc" = "Prepara té o una bebida caliente y bebe despacio sin mirar el móvil.";
"challenge.neck_stretch" = "Estiramiento de cuello y hombros";
"challenge.neck_stretch.desc" = "Rota los hombros hacia atrás, inclina la cabeza suavemente de lado a lado y libera la tensión.";
"challenge.delete_shortcut" = "Elimina un acceso directo que distraiga";
