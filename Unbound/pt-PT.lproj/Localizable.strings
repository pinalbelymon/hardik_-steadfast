/* Challenges & Rescue */
"challenge.deep_breaths" = "Faz 10 respirações profundas";
"challenge.deep_breaths.desc" = "Inspira lentamente pelo nariz, segura um pouco e expira pela boca. Repete até te sentires mais calmo.";
"challenge.drink_water" = "Bebe um copo de água";
"challenge.drink_water.desc" = "Enche um copo e bebe-o devagar. A hidratação ajuda a reiniciar o corpo e a mente.";
"challenge.jumping_jacks" = "Faz 20 polichinelos";
"challenge.jumping_jacks.desc" = "Fica de pé, salta abrindo braços e pernas e regressa. Move-te a um ritmo confortável.";
"challenge.phone_away_5min" = "Pousa o telemóvel durante 5 minutos";
"challenge.phone_away_5min.desc" = "Coloca o telemóvel virado para baixo ou noutro sítio. Usa a pausa para respirar ou olhar em volta.";
"challenge.grateful" = "Escreve 3 coisas pelas quais és grato";
"challenge.grateful.desc" = "Pega em papel ou notas e escreve três pequenas coisas que correram bem hoje.";
"challenge.walk_2min" = "Caminha durante 2 minutos";
"challenge.walk_2min.desc" = "Afasta-te do ecrã e caminha para qualquer lado — corredor, quarto ou exterior.";
"challenge.name_5_things" = "Nomeia 5 coisas que vês";
"challenge.name_5_things.desc" = "Olha em volta e nomeia em silêncio cinco objetos que consigas ver. Isto ancora-te no presente.";
"challenge.mindfulness_2min" = "2 minutos de atenção plena";
"challenge.mindfulness_2min.desc" = "Senta-te quieto e repara na respiração, nos sons e no corpo. Quando a mente divagar, regressa suavemente.";
"challenge.social_media_5min" = "Pausa de 5 minutos nas redes sociais";
"challenge.social_media_5min.desc" = "Fecha as aplicações de redes sociais e faz algo offline — alonga-te, bebe água ou simplesmente respira.";
"challenge.stretch_2min" = "Alonga-te durante 2 minutos";
"challenge.stretch_2min.desc" = "Estica os braços para cima, roda os ombros e alonga suavemente o pescoço e as costas.";
"challenge.walk_5min" = "Caminha durante 5 minutos";
"challenge.walk_5min.desc" = "Faz uma pequena caminhada sem o telemóvel. Repara nos teus passos e no ambiente.";
"challenge.listen_song" = "Ouve uma música";
"challenge.listen_song.desc" = "Põe uma música de que gostes e ouve-a completa — sem deslizar.";
"challenge.sit_outside" = "Senta-te lá fora durante 2 minutos";
"challenge.sit_outside.desc" = "Sai ou abre uma janela e senta-te em silêncio durante alguns minutos.";
"challenge.wash_face" = "Lava a cara";
"challenge.wash_face.desc" = "Salpica água fresca no rosto. O reinício físico pode interromper rapidamente um impulso.";
"challenge.open_window" = "Abre uma janela para ar fresco";
"challenge.open_window.desc" = "Deixa entrar ar fresco e faz algumas respirações profundas junto à janela.";
"challenge.tidy_desk" = "Arruma a secretária durante 3 minutos";
"challenge.tidy_desk.desc" = "Tira a desarrumação, empilha papéis e põe uma área em ordem.";
"challenge.read_2_pages" = "Lê duas páginas";
"challenge.read_2_pages.desc" = "Abre um livro ou artigo e lê apenas duas páginas — sem telemóvel por perto.";
"challenge.message_friend" = "Envia uma mensagem a um amigo";
"challenge.message_friend.desc" = "Envia uma saudação genuína a alguém de quem gostes. A conexão vence o deslizar infinito.";
"challenge.squats_10" = "Faz 10 agachamentos";
"challenge.squats_10.desc" = "Pés à largura dos ombros, desce as ancas e ergue-te. Vai devagar e com controlo.";
"challenge.journal_line" = "Escreve uma linha de diário";
"challenge.journal_line.desc" = "Escreve uma frase honesta sobre como te sentes neste momento.";
"challenge.box_breathing" = "Respiração em caixa durante 1 minuto";
"challenge.box_breathing.desc" = "Inspira 4 tempos, segura 4, expira 4, segura 4. Repete durante um minuto.";
"challenge.sunlight_2min" = "Expõe-te à luz do sol durante 2 minutos";
"challenge.sunlight_2min.desc" = "Fica perto de uma janela ou sai e sente a luz no rosto.";
"challenge.make_bed" = "Faz a cama";
"challenge.make_bed.desc" = "Estica os lençóis e reinicia o teu espaço. As pequenas vitórias criam impulso.";
"challenge.calm_audio" = "Ouve áudio calmante";
"challenge.calm_audio.desc" = "Põe algo relaxante — sons da natureza, música suave ou uma meditação curta.";
"challenge.phone_other_room" = "Põe o telemóvel noutro quarto";
"challenge.phone_other_room.desc" = "Deixa o telemóvel noutro quarto durante alguns minutos enquanto te reinicias.";
"challenge.plan_tomorrow" = "Planeia um objetivo para amanhã";
"challenge.plan_tomorrow.desc" = "Escreve um objetivo pequeno e claro que queiras cumprir amanhã.";
"challenge.kind_self" = "Diz algo gentil a ti mesmo";
"challenge.kind_self.desc" = "Fala contigo como um bom amigo — uma frase de encorajamento em voz alta.";
"challenge.digital_break_10" = "Pausa de ecrã de 10 minutos";
"challenge.digital_break_10.desc" = "Afasta-te de todos os ecrãs durante dez minutos. Mexe-te, respira ou descansa os olhos.";
"challenge.stand_stretch" = "Levanta-te e alonga-te durante 1 minuto";
"challenge.stand_stretch.desc" = "Levanta-te, estica para cima e solta ombros e costas.";
"challenge.draw_something" = "Desenha algo durante 5 minutos";
"challenge.draw_something.desc" = "Rabisca, esboça ou pinta durante cinco minutos — não é preciso perfeição.";
"challenge.clean_one_area" = "Limpa uma área pequena";
"challenge.clean_one_area.desc" = "Escolhe um sítio — uma prateleira, bancada ou gaveta — e arruma-o durante cinco minutos.";
"challenge.no_phone_meal" = "Come sem o telemóvel";
"challenge.no_phone_meal.desc" = "Faz um lanche ou refeição sem ecrãs. Concentra-te no sabor e em como te sentes.";
"challenge.pushups_5" = "Faz 5 flexões";
"challenge.pushups_5.desc" = "Faz cinco flexões no chão ou contra a parede. A forma importa mais do que a velocidade.";
"challenge.focus_5min" = "Bloco de foco de 5 minutos";
"challenge.focus_5min.desc" = "Escolhe uma tarefa e trabalha nela sem distrações durante cinco minutos.";
"challenge.gratitude_text" = "Envia uma mensagem de agradecimento";
"challenge.gratitude_text.desc" = "Envia a alguém um breve agradecimento ou uma nota gentil. A gratidão reforça a recuperação.";
"challenge.walk_outside" = "Caminha lá fora durante 5 minutos";
"challenge.walk_outside.desc" = "Sai de casa ou do escritório e caminha a um ritmo fácil durante cinco minutos.";
"challenge.tea_break" = "Faz uma pausa de chá consciente";
"challenge.tea_break.desc" = "Prepara chá ou uma bebida quente e bebe devagar sem olhar para o telemóvel.";
