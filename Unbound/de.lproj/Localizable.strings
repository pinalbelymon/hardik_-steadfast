"challenge.deep_breaths" = "Nimm 10 tiefe Atemzüge";
"challenge.deep_breaths.desc" = "Atme langsam durch die Nase ein, halte kurz an und atme durch den Mund aus. Wiederhole, bis du dich ruhiger fühlst.";
"challenge.drink_water" = "Trinke ein Glas Wasser";
"challenge.drink_water.desc" = "Fülle ein Glas und trinke es langsam. Flüssigkeitszufuhr hilft, Körper und Geist zurückzusetzen.";
"challenge.jumping_jacks" = "Mache 20 Hampelmänner";
"challenge.jumping_jacks.desc" = "Stehe aufrecht, springe und spreize Arme und Beine, dann zurück. Bewege dich in einem angenehmen Tempo.";
"challenge.phone_away_5min" = "Lege das Handy 5 Minuten beiseite";
"challenge.phone_away_5min.desc" = "Lege dein Handy mit dem Display nach unten oder an einen anderen Ort. Nutze die Pause zum Atmen oder Umschauen.";
"challenge.grateful" = "Schreibe 3 Dinge auf, für die du dankbar bist";
"challenge.grateful.desc" = "Nimm Papier oder Notizen und schreibe drei kleine Dinge auf, die heute gut gelaufen sind.";
"challenge.walk_2min" = "Gehe 2 Minuten spazieren";
"challenge.walk_2min.desc" = "Geh von deinem Bildschirm weg und laufe irgendwohin – Flur, Zimmer oder draußen.";
"challenge.name_5_things" = "Nenne 5 Dinge, die du siehst";
"challenge.name_5_things.desc" = "Schau dich um und benenne leise fünf Gegenstände, die du sehen kannst. Das verankert dich in der Gegenwart.";
"challenge.mindfulness_2min" = "2 Minuten Achtsamkeit";
"challenge.mindfulness_2min.desc" = "Sitze still und beachte deinen Atem, Geräusche und Körper. Wenn deine Gedanken abschweifen, kehre sanft zurück.";
"challenge.social_media_5min" = "5-Minuten-Pause von sozialen Medien";
"challenge.social_media_5min.desc" = "Schließe Social-Media-Apps und mache etwas Offline – dehne dich, trinke etwas oder atme einfach.";
"challenge.stretch_2min" = "Dehne dich 2 Minuten";
"challenge.stretch_2min.desc" = "Strecke dich nach oben, rolle die Schultern und dehne sanft Nacken und Rücken.";
"challenge.walk_5min" = "Gehe 5 Minuten spazieren";
"challenge.walk_5min.desc" = "Mache einen kurzen Spaziergang ohne Handy. Beachte deine Schritte und die Umgebung.";
"challenge.listen_song" = "Höre ein Lied";
"challenge.listen_song.desc" = "Spiele ein Lied, das dir gefällt, und höre es vollständig – ohne zu scrollen.";
"challenge.sit_outside" = "Setze dich 2 Minuten nach draußen";
"challenge.sit_outside.desc" = "Geh nach draußen oder öffne ein Fenster und sitze ein paar Minuten ruhig.";
"challenge.wash_face" = "Wasche dir das Gesicht";
"challenge.wash_face.desc" = "Spritze kühles Wasser ins Gesicht. Der physische Reset kann einen Drang schnell unterbrechen.";
"challenge.open_window" = "Öffne ein Fenster für frische Luft";
"challenge.open_window.desc" = "Lass frische Luft herein und nimm ein paar tiefe Atemzüge am Fenster.";
"challenge.tidy_desk" = "Räume deinen Schreibtisch 3 Minuten auf";
"challenge.tidy_desk.desc" = "Räume Unordnung weg, stapel Papiere und bringe einen Bereich in Ordnung.";
"challenge.read_2_pages" = "Lies zwei Seiten";
"challenge.read_2_pages.desc" = "Öffne ein Buch oder einen Artikel und lies nur zwei Seiten – ohne Handy in der Nähe.";
"challenge.message_friend" = "Schreibe einem Freund";
"challenge.message_friend.desc" = "Sende eine echte Nachricht an jemanden, der dir wichtig ist. Verbindung schlägt Scrollen.";
"challenge.squats_10" = "Mache 10 Kniebeugen";
"challenge.squats_10.desc" = "Füße schulterbreit, senke die Hüften und stehe wieder auf. Geh langsam und kontrolliert.";
"challenge.journal_line" = "Schreibe eine Tagebuchzeile";
"challenge.journal_line.desc" = "Schreibe einen ehrlichen Satz darüber, wie du dich gerade fühlst.";
