"challenge.box_breathing.desc" = "Atme 4 Zählzeiten ein, halte 4, aus 4, halte 4. Wiederhole eine Minute lang.";
"challenge.sunlight_2min" = "Stelle dich 2 Minuten ins Sonnenlicht";
"challenge.sunlight_2min.desc" = "Stelle dich an ein Fenster oder geh nach draußen und spüre das Licht im Gesicht.";
"challenge.make_bed" = "Mache dein Bett";
"challenge.make_bed.desc" = "Glätte die Laken und setze deinen Raum zurück. Kleine Siege bauen Schwung auf.";
"challenge.calm_audio" = "Höre beruhigendes Audio";
