"challenge.stand_stretch.desc" = "Stehe auf, strecke dich hoch und lockere Schultern und Rücken.";
"challenge.draw_something" = "Zeichne 5 Minuten etwas";
"challenge.draw_something.desc" = "Kritzel, skizziere oder male fünf Minuten – Perfektion ist nicht nötig.";
"challenge.clean_one_area" = "Räume einen kleinen Bereich auf";
