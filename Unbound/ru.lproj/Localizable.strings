"challenge.deep_breaths" = "Сделай 10 глубоких вдохов";
"challenge.deep_breaths.desc" = "Медленно вдохни через нос, задержи на мгновение, затем выдохни через рот. Повторяй, пока не почувствуешь себя спокойнее.";
"challenge.drink_water" = "Выпей стакан воды";
"challenge.drink_water.desc" = "Наполни стакан и медленно выпей. Гидратация помогает сбросить тело и разум.";
"challenge.jumping_jacks" = "Сделай 20 прыжков с разведением рук и ног";
"challenge.jumping_jacks.desc" = "Встань прямо, прыгай, разводя руки и ноги, затем возвращайся. Двигайся в комфортном темпе.";
"challenge.phone_away_5min" = "Убери телефон на 5 минут";
"challenge.phone_away_5min.desc" = "Положи телефон экраном вниз или в другое место. Используй паузу, чтобы подышать или осмотреться.";
"challenge.grateful" = "Напиши 3 вещи, за которые ты благодарен";
"challenge.grateful.desc" = "Возьми бумагу или заметки и напиши три маленькие вещи, которые сегодня получились.";
"challenge.walk_2min" = "Пройдись 2 минуты";
"challenge.walk_2min.desc" = "Отойди от экрана и пройдись куда угодно — по коридору, комнате или на улице.";
"challenge.name_5_things" = "Назови 5 вещей, которые видишь";
"challenge.name_5_things.desc" = "Оглянись и тихо назови пять предметов, которые видишь. Это заземляет тебя в настоящем.";
"challenge.mindfulness_2min" = "2 минуты осознанности";
"challenge.mindfulness_2min.desc" = "Сядь спокойно и замечай дыхание, звуки и тело. Когда ум уходит, мягко возвращайся.";
"challenge.social_media_5min" = "5-минутный перерыв от соцсетей";
"challenge.social_media_5min.desc" = "Закрой соцсети и сделай что-то офлайн — потянись, выпей воды или просто подыши.";
"challenge.stretch_2min" = "Потянись 2 минуты";
"challenge.stretch_2min.desc" = "Подними руки над головой, покрути плечами и мягко потяни шею и спину.";
"challenge.walk_5min" = "Пройдись 5 минут";
"challenge.walk_5min.desc" = "Сделай короткую прогулку без телефона. Замечай шаги и окружение.";
"challenge.listen_song" = "Послушай одну песню";
"challenge.listen_song.desc" = "Включи одну песню, которую любишь, и слушай её полностью — без скроллинга.";
"challenge.sit_outside" = "Посиди снаружи 2 минуты";
"challenge.sit_outside.desc" = "Выйди или открой окно и спокойно посиди пару минут.";
"challenge.wash_face" = "Умой лицо";
"challenge.wash_face.desc" = "Брызни холодной водой на лицо. Физический сброс может быстро прервать тягу.";
"challenge.open_window" = "Открой окно для свежего воздуха";
"challenge.open_window.desc" = "Впусти свежий воздух и сделай несколько глубоких вдохов у окна.";
"challenge.tidy_desk" = "Убери стол 3 минуты";
"challenge.tidy_desk.desc" = "Убери беспорядок, сложи бумаги и приведи одно место в порядок.";
