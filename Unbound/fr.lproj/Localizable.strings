"challenge.deep_breaths" = "Prends 10 respirations profondes";
"challenge.deep_breaths.desc" = "Inspire lentement par le nez, retiens brièvement, puis expire par la bouche. Répète jusqu’à te sentir plus calme.";
"challenge.drink_water" = "Bois un verre d’eau";
"challenge.drink_water.desc" = "Remplis un verre et bois-le lentement. L’hydratation aide à réinitialiser le corps et l’esprit.";
"challenge.jumping_jacks" = "Fais 20 jumping jacks";
"challenge.jumping_jacks.desc" = "Tiens-toi droit, saute en écartant bras et jambes, puis reviens. Bouge à un rythme confortable.";
"challenge.phone_away_5min" = "Écarte ton téléphone pendant 5 minutes";
"challenge.phone_away_5min.desc" = "Pose ton téléphone face contre terre ou dans un autre endroit. Utilise la pause pour respirer ou regarder autour de toi.";
"challenge.grateful" = "Écris 3 choses pour lesquelles tu es reconnaissant";
"challenge.grateful.desc" = "Prends du papier ou des notes et écris trois petites choses qui se sont bien passées aujourd’hui.";
"challenge.walk_2min" = "Marche pendant 2 minutes";
"challenge.walk_2min.desc" = "Éloigne-toi de l’écran et marche n’importe où — couloir, pièce ou dehors.";
"challenge.name_5_things" = "Nomme 5 choses que tu vois";
"challenge.name_5_things.desc" = "Regarde autour de toi et nomme silencieusement cinq objets que tu vois. Cela t’ancre dans le présent.";
"challenge.mindfulness_2min" = "2 minutes de pleine conscience";
"challenge.mindfulness_2min.desc" = "Assieds-toi tranquillement et observe ta respiration, les sons et ton corps. Quand ton esprit s’égare, reviens doucement.";
"challenge.social_media_5min" = "Pause réseaux sociaux de 5 minutes";
"challenge.social_media_5min.desc" = "Ferme les apps sociales et fais quelque chose hors ligne — étire-toi, bois un peu d’eau ou respire simplement.";
"challenge.stretch_2min" = "Étire-toi pendant 2 minutes";
"challenge.stretch_2min.desc" = "Lève les bras au-dessus de la tête, roule les épaules et étire doucement le cou et le dos.";
"challenge.walk_5min" = "Marche pendant 5 minutes";
"challenge.walk_5min.desc" = "Fais une courte marche sans ton téléphone. Observe tes pas et ton environnement.";
"challenge.listen_song" = "Écoute une chanson";
"challenge.listen_song.desc" = "Joue une chanson que tu aimes et écoute-la pleinement — sans scroller pendant qu’elle joue.";
"challenge.sit_outside" = "Assieds-toi dehors pendant 2 minutes";
"challenge.sit_outside.desc" = "Sors ou ouvre une fenêtre et assieds-toi tranquillement pendant quelques minutes.";
"challenge.wash_face" = "Lave-toi le visage";
"challenge.wash_face.desc" = "Asperge ton visage d’eau froide. Cette réinitialisation physique peut briser une envie rapidement.";
"challenge.open_window" = "Ouvre une fenêtre pour de l’air frais";
